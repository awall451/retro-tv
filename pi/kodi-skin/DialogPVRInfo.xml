<?xml version="1.0" encoding="UTF-8"?>
<!--
  Show details pop-up (guide: Square / Info) for the Trinitron skin (skin.estuary.crt).
  Replaces Estuary's DialogPVRInfo.xml, which Kodi also uses for recording details.
  Same 1920x1440 canvas as MyPVRGuide.xml: divide by 3 for real 640x480 pixels.
  Button ids are Kodi's: 5 switch to channel, 8 play recording, 6 record.
-->
<window>
	<defaultcontrol always="true">5</defaultcontrol>
	<controls>
		<control type="group">
			<animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="120">WindowClose</animation>
			<!-- yellow frame and navy panel, 18 px from each edge -->
			<control type="image">
				<left>54</left>
				<top>54</top>
				<width>1812</width>
				<height>1332</height>
				<texture colordiffuse="FFF2C200">colors/white.png</texture>
			</control>
			<control type="image">
				<left>60</left>
				<top>60</top>
				<width>1800</width>
				<height>1320</height>
				<texture colordiffuse="FF0A1240">colors/white.png</texture>
			</control>
			<control type="group">
				<left>120</left>
				<top>96</top>
				<width>1680</width>
				<control type="label">
					<top>0</top>
					<height>60</height>
					<font>crt_guide</font>
					<textcolor>FFF2C200</textcolor>
					<label>$INFO[ListItem.ChannelNumberLabel,Ch , · ]$INFO[ListItem.ChannelName]</label>
				</control>
				<control type="label">
					<top>66</top>
					<height>90</height>
					<font>crt_big</font>
					<textcolor>FFFFFFFF</textcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.Title]</label>
				</control>
				<control type="label">
					<top>162</top>
					<height>60</height>
					<font>crt_info</font>
					<textcolor>FFCFE0FF</textcolor>
					<scroll>true</scroll>
					<label>$INFO[ListItem.EpisodeName,&quot;,&quot;]</label>
				</control>
				<control type="label">
					<top>228</top>
					<height>60</height>
					<font>crt_info</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]$INFO[ListItem.ParentalRatingCode,  ·  ]$INFO[ListItem.Genre,  ·  ]</label>
				</control>
				<control type="textbox">
					<top>312</top>
					<height>690</height>
					<font>crt_info</font>
					<textcolor>FFCFE0FF</textcolor>
					<label>$INFO[ListItem.Plot]</label>
					<autoscroll delay="6000" time="3000" repeat="6000">true</autoscroll>
				</control>
			</control>
			<!-- buttons: Watch now (or Play for recordings) and Record -->
			<control type="grouplist" id="9000">
				<left>120</left>
				<top>1146</top>
				<width>1680</width>
				<height>150</height>
				<itemgap>36</itemgap>
				<orientation>horizontal</orientation>
				<onleft>9000</onleft>
				<onright>9000</onright>
				<control type="button" id="5">
					<width>660</width>
					<height>150</height>
					<font>crt_title</font>
					<textoffsetx>36</textoffsetx>
					<align>center</align>
					<aligny>center</aligny>
					<label>Watch now</label>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FF0A1240</focusedcolor>
					<texturefocus colordiffuse="FFF2C200">colors/white.png</texturefocus>
					<texturenofocus colordiffuse="FF1C3FA8">colors/white.png</texturenofocus>
					<visible>Window.IsActive(PVRGuideInfo)</visible>
				</control>
				<control type="button" id="8">
					<width>660</width>
					<height>150</height>
					<font>crt_title</font>
					<align>center</align>
					<aligny>center</aligny>
					<label>Play</label>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FF0A1240</focusedcolor>
					<texturefocus colordiffuse="FFF2C200">colors/white.png</texturefocus>
					<texturenofocus colordiffuse="FF1C3FA8">colors/white.png</texturenofocus>
					<visible>Window.IsActive(PVRRecordingInfo)</visible>
				</control>
				<control type="button" id="6">
					<width>480</width>
					<height>150</height>
					<font>crt_title</font>
					<align>center</align>
					<aligny>center</aligny>
					<textcolor>FFFFFFFF</textcolor>
					<focusedcolor>FF0A1240</focusedcolor>
					<texturefocus colordiffuse="FFF2C200">colors/white.png</texturefocus>
					<texturenofocus colordiffuse="FF1C3FA8">colors/white.png</texturenofocus>
					<visible>Window.IsActive(PVRGuideInfo)</visible>
				</control>
			</control>
		</control>
	</controls>
</window>
