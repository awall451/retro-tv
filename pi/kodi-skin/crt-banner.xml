<!--
  Live-TV channel banner for the Trinitron skin, in the retro guide's navy and yellow.
  make_kodi_crt_skin.sh inserts this group into DialogSeekBar.xml (before </controls>) and hides
  Estuary's own live-TV info while it shows. It appears when you change channel or press Info
  while watching live TV. Coordinates: 1920x1440 canvas = 3x the real 640x480 pixels.
  Shown when: [Player.ShowInfo | Window.IsActive(fullscreeninfo)] + VideoPlayer.Content(LiveTV)
              + !Window.IsVisible(videoosd)
-->
<control type="group">
	<visible>[Player.ShowInfo | Window.IsActive(fullscreeninfo)] + VideoPlayer.Content(LiveTV) + !Window.IsVisible(videoosd)</visible>
	<animation effect="slide" start="0,520" end="0,0" time="250" tween="cubic" easing="out">Visible</animation>
	<animation effect="slide" start="0,0" end="0,520" time="200" tween="cubic" easing="in">Hidden</animation>
	<left>48</left>
	<top>900</top>
	<width>1824</width>
	<height>492</height>
	<!-- yellow frame, navy panel -->
	<control type="image">
		<left>0</left><top>0</top><width>1824</width><height>492</height>
		<texture colordiffuse="FFF2C200">colors/white.png</texture>
	</control>
	<control type="image">
		<left>6</left><top>6</top><width>1812</width><height>480</height>
		<texture colordiffuse="FF0A1240">colors/white.png</texture>
	</control>
	<!-- channel box: big number, name -->
	<control type="image">
		<left>6</left><top>6</top><width>360</width><height>480</height>
		<texture colordiffuse="FF1C3FA8">colors/white.png</texture>
	</control>
	<control type="label">
		<left>6</left><top>36</top><width>360</width><height>150</height>
		<align>center</align><aligny>center</aligny>
		<font>crt_num</font><textcolor>FFF2C200</textcolor>
		<label>$INFO[VideoPlayer.ChannelNumberLabel]</label>
	</control>
	<control type="textbox">
		<left>30</left><top>210</top><width>312</width><height>246</height>
		<align>center</align>
		<font>crt_guide</font><textcolor>FFFFFFFF</textcolor>
		<label>$INFO[VideoPlayer.ChannelName]</label>
	</control>
	<!-- show -->
	<control type="group">
		<left>402</left><top>24</top><width>1392</width>
		<control type="label">
			<top>0</top><height>78</height><width>1392</width>
			<font>crt_title</font><textcolor>FFFFFFFF</textcolor><scroll>true</scroll>
			<label>$INFO[VideoPlayer.Title]</label>
		</control>
		<control type="label">
			<top>78</top><height>60</height><width>1392</width>
			<font>crt_info</font><textcolor>FFCFE0FF</textcolor>
			<label>$INFO[VideoPlayer.EpisodeName,&quot;,&quot;]</label>
		</control>
		<control type="label">
			<top>141</top><height>60</height><width>1392</width>
			<font>crt_info</font><textcolor>FFFFFFFF</textcolor>
			<label>$INFO[VideoPlayer.StartTime]$INFO[VideoPlayer.EndTime, – ]</label>
		</control>
		<control type="label">
			<top>141</top><height>60</height><width>1392</width><align>right</align>
			<font>crt_info</font><textcolor>FFF2C200</textcolor>
			<label>$INFO[System.Time]</label>
		</control>
		<!-- progress through the show: yellow on dark blue, 8 px -->
		<control type="progress">
			<top>213</top><height>24</height><width>1392</width>
			<texturebg colordiffuse="FF1C3FA8">colors/white.png</texturebg>
			<midtexture colordiffuse="FFF2C200">colors/white.png</midtexture>
			<info>PVR.EpgEventProgress</info>
		</control>
		<control type="textbox">
			<top>258</top><height>108</height><width>1392</width>
			<font>crt_plot</font><textcolor>FFCFE0FF</textcolor>
			<label>$INFO[VideoPlayer.Plot]</label>
		</control>
		<control type="label">
			<top>390</top><height>60</height><width>1392</width>
			<font>crt_guide</font><textcolor>FFF2C200</textcolor><scroll>true</scroll>
			<label>$INFO[VideoPlayer.NextStartTime,Next ,  ]$INFO[VideoPlayer.NextTitle]</label>
		</control>
	</control>
</control>
