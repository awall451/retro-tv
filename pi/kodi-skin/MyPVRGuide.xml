<?xml version="1.0" encoding="UTF-8"?>
<!--
  Retro cable-style TV guide for the Trinitron (skin.estuary.crt).
  Replaces Estuary's MyPVRGuide.xml in the CRT copy of the skin.
  Coordinates are Estuary's 4:3 canvas (1920x1440), exactly 3x the Pi's 640x480 output,
  so every number here is (640x480 pixels) x 3. Keep lines and gaps at least 6 units
  (2 real pixels): 1-pixel lines flicker on 480i.
  Fonts crt_* are added to Font.xml by make_kodi_skin.sh (Cabin Bold); colours are $VAR[Retro*]
  from retro-variables.xml so the theme setting recolours the screen.
-->
<window>
	<defaultcontrol always="true">50</defaultcontrol>
	<views>50</views>
	<controls>
		<!-- navy background -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1440</height>
			<texture colordiffuse="$VAR[RetroNavy]">colors/white.png</texture>
		</control>

		<!-- preview: what's playing now, in a yellow frame -->
		<control type="image">
			<left>24</left>
			<top>24</top>
			<width>768</width>
			<height>579</height>
			<texture colordiffuse="$VAR[RetroYellow]">colors/white.png</texture>
		</control>
		<control type="image">
			<left>30</left>
			<top>30</top>
			<width>756</width>
			<height>567</height>
			<texture colordiffuse="FF000000">colors/white.png</texture>
		</control>
		<control type="videowindow">
			<left>30</left>
			<top>30</top>
			<width>756</width>
			<height>567</height>
			<visible>Player.HasVideo</visible>
			<animation effect="zoom" start="0,0,1920,1440" end="30,30,756,567" time="350" tween="cubic" easing="out">WindowOpen</animation>
			<animation effect="zoom" start="30,30,756,567" end="0,0,1920,1440" time="300" tween="cubic" easing="in">WindowClose</animation>
		</control>
		<control type="label">
			<left>30</left>
			<top>30</top>
			<width>756</width>
			<height>567</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>crt_info</font>
			<textcolor>$VAR[RetroSoft]</textcolor>
			<label>Press Select on a show to watch</label>
			<visible>!Player.HasVideo</visible>
		</control>

		<!-- details of the highlighted show -->
		<control type="group">
			<left>822</left>
			<top>24</top>
			<width>1074</width>
			<control type="label">
				<top>0</top>
				<height>60</height>
				<font>crt_guide</font>
				<textcolor>$VAR[RetroAccent]</textcolor>
				<label>$INFO[ListItem.ChannelNumberLabel,Ch , · ]$INFO[ListItem.ChannelName]</label>
			</control>
			<control type="label">
				<top>63</top>
				<height>78</height>
				<font>crt_title</font><visible>!Skin.HasSetting(retro.vapor)</visible>
				<textcolor>FFFFFFFF</textcolor>
				<scroll>true</scroll>
				<label>$INFO[ListItem.Title]</label>
			</control>
			<control type="label">
				<top>63</top>
				<height>78</height>
				<font>crt_title_vapor</font><visible>Skin.HasSetting(retro.vapor)</visible>
				<textcolor>FFFFFFFF</textcolor>
				<scroll>true</scroll>
				<label>$INFO[ListItem.Title]</label>
			</control>
			<control type="label">
				<top>144</top>
				<height>60</height>
				<font>crt_info</font>
				<textcolor>$VAR[RetroSoft]</textcolor>
				<label>$INFO[ListItem.EpisodeName,&quot;,&quot;]</label>
			</control>
			<control type="label">
				<top>207</top>
				<height>60</height>
				<font>crt_info</font>
				<textcolor>FFFFFFFF</textcolor>
				<label>$INFO[ListItem.StartTime]$INFO[ListItem.EndTime, – ]</label>
			</control>
			<control type="textbox">
				<top>276</top>
				<height>306</height>
				<font>crt_plot</font>
				<textcolor>$VAR[RetroSoft]</textcolor>
				<label>$INFO[ListItem.Plot]</label>
				<autoscroll delay="8000" time="3000" repeat="8000">true</autoscroll>
			</control>
		</control>

		<!-- settings hint, bottom right of the details area -->
		<control type="label">
			<left>1296</left>
			<top>582</top>
			<width>600</width>
			<height>42</height>
			<align>right</align>
			<font>crt_plot</font>
			<textcolor>$VAR[RetroSoft]</textcolor>
			<label>Settings: Triangle / Y</label>
		</control>

		<!-- the grid: 8 channel rows x 90 minutes (18 five-minute blocks) -->
		<control type="epggrid" id="50">
			<left>0</left>
			<top>630</top>
			<width>1920</width>
			<height>783</height>
			<orientation>vertical</orientation>
			<scrolltime tween="quadratic" easing="out">200</scrolltime>
			<timeblocks>18</timeblocks>
			<rulerunit>6</rulerunit>
			<viewtype label="19298">list</viewtype>
			<!-- Circle/Back: back to the show if one is playing, otherwise normal Back -->
			<onback condition="Player.HasVideo">FullScreen</onback>
			<rulerlayout height="87" width="512">
				<!-- Kodi's first ruler item is the date and sits over the channel column: show day and clock there -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>378</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroYellow]">colors/white.png</texture>
					<visible>!String.Contains(ListItem.Label,:)</visible>
				</control>
				<control type="label">
					<left>21</left>
					<top>0</top>
					<width>350</width>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>$VAR[RetroInk]</textcolor>
					<label>$INFO[System.Date(ddd)] $INFO[System.Time]</label>
					<visible>!String.Contains(ListItem.Label,:)</visible>
				</control>
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>506</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroTimebar]">colors/white.png</texture>
					<visible>String.Contains(ListItem.Label,:)</visible>
				</control>
				<control type="label">
					<left>21</left>
					<top>0</top>
					<width>480</width>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
					<visible>String.Contains(ListItem.Label,:)</visible>
				</control>
			</rulerlayout>
			<channellayout height="87" width="384">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>378</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroChannel]">colors/white.png</texture>
				</control>
				<control type="label">
					<left>21</left>
					<top>0</top>
					<width>350</width>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.ChannelNumberLabel,, ]$INFO[ListItem.ChannelName]</label>
				</control>
			</channellayout>
			<focusedchannellayout height="87" width="384">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>378</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroYellow]">colors/white.png</texture>
				</control>
				<control type="label">
					<left>21</left>
					<top>0</top>
					<width>350</width>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>$VAR[RetroInk]</textcolor>
					<label>$INFO[ListItem.ChannelNumberLabel,, ]$INFO[ListItem.ChannelName]</label>
				</control>
			</focusedchannellayout>
			<itemlayout height="87" width="60">
				<control type="image" id="2">
					<left>0</left>
					<top>0</top>
					<width>54</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroProgram]">colors/white.png</texture>
				</control>
				<control type="label" id="1">
					<left>21</left>
					<top>0</top>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>FFFFFFFF</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="87" width="60">
				<control type="image" id="2">
					<left>0</left>
					<top>0</top>
					<width>54</width>
					<height>81</height>
					<texture colordiffuse="$VAR[RetroYellow]">colors/white.png</texture>
				</control>
				<control type="label" id="1">
					<left>21</left>
					<top>0</top>
					<height>81</height>
					<aligny>center</aligny>
					<font>crt_guide</font>
					<textcolor>$VAR[RetroInk]</textcolor>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
