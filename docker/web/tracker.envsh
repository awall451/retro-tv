#!/bin/sh
# Watch beacons (see docker/README.md, "Watch beacons"): turns TRACKER_URL into
#  - /tmp/tracker.json (or $TRACKER_JSON), {"url": "<tracker>"} for the app,
#    or {} when it is empty (no beacons), and
#  - TRACKER_CONNECT_SRC, the tracker's origin, which the nginx template adds
#    to the Content-Security-Policy's connect-src.
#
# TRACKER_URL=https://tracker.example   (scheme, host, optional port; no path)
#
# A bad value is skipped with a warning and the container still starts. The
# nginx entrypoint sources this file (*.envsh) before it fills in the
# templates; the Retro TV box's setup.sh sources it too.

TRACKER_CONNECT_SRC=
_tracker_json='{}'
_tracker_url=$(printf '%s' "${TRACKER_URL:-}" | sed -e 's|/*$||')
if [ -n "$_tracker_url" ]; then
  if printf '%s' "$_tracker_url" | grep -Eq '^https?://([A-Za-z0-9.-]+|\[[0-9A-Fa-f:.]+\])(:[0-9]{1,5})?$'; then
    TRACKER_CONNECT_SRC=$(printf '%s' "$_tracker_url" | tr 'A-Z' 'a-z')
    _tracker_json="{\"url\": \"$TRACKER_CONNECT_SRC\"}"
    echo "tracker: watch beacons go to $TRACKER_CONNECT_SRC" >&2
  else
    echo "tracker: skipped TRACKER_URL \"$_tracker_url\": not a plain http(s)://host[:port]" >&2
  fi
fi
printf '%s\n' "$_tracker_json" > "${TRACKER_JSON:-/tmp/tracker.json}"
unset _tracker_url _tracker_json
export TRACKER_CONNECT_SRC
