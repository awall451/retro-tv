# Uplink: only for machines where Docker's bridge networks cannot route
# out (see compose.uplink.yaml). It runs on the host's network, listens on
# the Docker bridge address only, and passes the viewer's requests on to
# ErsatzTV unchanged. The viewer container keeps the real rules (which
# paths, the URL rewriting); this one just repeats the two cheap ones:
# /iptv/ only, GET only.

server {
  listen ${UPLINK_BIND}:${UPLINK_PORT};
  server_name _;
  server_tokens off;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /iptv/ {
    limit_except GET { deny all; }
    proxy_pass ${ERSATZTV_URL};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_buffering off;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  location / { return 404; }
}
