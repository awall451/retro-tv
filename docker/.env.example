# Copy to .env (git-ignored) and fill in.

# Where ErsatzTV answers, as seen from this machine. Scheme, address and
# port only: no trailing slash, no path. Use an address that works both
# at home and away if the server has one (for example its tailnet IP).
ERSATZTV_URL=http://<server-ip>:8409

# Port the viewer is published on. Gantry routes to it.
VIEWER_PORT=8410

# Where the port is open. 127.0.0.1 (default): this machine only, other
# devices come in through Gantry. 0.0.0.0: also every device on the local
# network, at http://<this-machine-ip>:8410, with no login. Use 0.0.0.0
# only on a network you trust.
#VIEWER_BIND=0.0.0.0

# Web channels: channels that show a web page instead of their stream
# (README.md, "Web channels"). <channel number>=<page URL>, separated by ";".
# The page's site is let into the viewer's Content-Security-Policy (frame-src).
#WEB_CHANNELS=192=https://weather.example/?kiosk=true

# Sleep timer (README, "Sleep timer"): after this many minutes without a key
# press, the viewer asks "Are you still watching?" when the programme on then
# ends, and stops if nobody answers within IDLE_PROMPT_SEC. 0: never (default).
#IDLE_TIMEOUT_MIN=90
#IDLE_PROMPT_SEC=60

# The TV Guide Channel generator (docker compose --profile tvguide up -d).
# The channel whose stream plays in the page's top half (promos, infomercials).
#TVGUIDE_PROMO=56
# Where ErsatzTV fetches the generated stream, as http://<this machine>:<port>/live.m3u8.
# 127.0.0.1 reaches only an ErsatzTV on this machine's host network; use 0.0.0.0
# when ErsatzTV runs in its own container or elsewhere.
#TVGUIDE_PORT=8412
#TVGUIDE_BIND=0.0.0.0
# Encoder settings: frames per second and video bitrate of the generated stream.
#TVGUIDE_FPS=30
#TVGUIDE_BITRATE=1800k

# Watch beacons: where browsers reach the channel tracker, as
# http(s)://<host>[:port] (no path). Empty: the viewer sends nothing.
#TRACKER_URL=http://<this-machine-ip>:8413

# The channel tracker (docker compose --profile tracker up -d --build).
# See ../tracker/README.md. Port and where it is open, as for the viewer.
#TRACKER_PORT=8413
#TRACKER_BIND=0.0.0.0
# The token for uploading snapshots and closing requests. Empty: one is made
# at first start (docker exec retro-tv-tracker cat /data/token).
#TRACKER_TOKEN=
# ErsatzTV's API key (from its /config/api-secrets.json), for the session
# poller that counts players other than this viewer (Roku, Kodi). Empty:
# only the viewer's beacons count.
#ERSATZTV_API_KEY=
# Time zone for "today" and the hour-of-day chart.
#TRACKER_TZ=America/New_York
# The addresses browsers open the viewer at; beacons from other pages are
# refused (http://localhost and 127.0.0.1 on any port are always allowed).
#TRACKER_ORIGINS=http://<this-machine-ip>:8410
# Names for the devices that send beacons, by the address the tracker sees.
#TRACKER_DEVICES=<pi-ip>=Retro TV box;<laptop-ip>=Laptop
# One name for every viewer in TV mode (?tv), when addresses do not tell them apart.
#TRACKER_TV_LABEL=Retro TV box
# 1 when the tracker sits behind a reverse proxy: take the address from X-Forwarded-For.
#TRACKER_TRUST_PROXY=1

# Only if containers on this machine cannot reach other machines
# (see compose.uplink.yaml): uncomment.
#COMPOSE_FILE=compose.yaml:compose.uplink.yaml
#UPLINK_PORT=8411
#UPLINK_BIND=172.17.0.1
