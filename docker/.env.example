# Copy to .env (git-ignored) and fill in.

# Where ErsatzTV answers, as seen from this machine. Scheme, address and
# port only: no trailing slash, no path. Use an address that works both
# at home and away if the server has one (for example its tailnet IP).
ERSATZTV_URL=http://<server-ip>:8409

# Port the viewer is published on. Gantry routes to it.
VIEWER_PORT=8410

# Where the port is open. 127.0.0.1 (default): this machine only, other
# devices come in through Gantry. 0.0.0.0: also every device on the local
# network, at http://<this-machine-ip>:8410, with no login. Use 0.0.0.0
# only on a network you trust.
#VIEWER_BIND=0.0.0.0

# Only if containers on this machine cannot reach other machines
# (see compose.uplink.yaml): uncomment.
#COMPOSE_FILE=compose.yaml:compose.uplink.yaml
#UPLINK_PORT=8411
#UPLINK_BIND=172.17.0.1
