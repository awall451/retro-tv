# Files that run or are read on the Pi must keep Unix line endings, whatever this PC's
# core.autocrlf says: a shell script with CRLF fails on Batocera.
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.cfg   text eol=lf
*.conf  text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.glslp text eol=lf
*.note  text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
# Windows scripts stay Windows
*.ps1   text eol=crlf
# Binary
*.png   binary
*.jpg   binary
