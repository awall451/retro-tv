# Secrets: never commit these
*_ed25519
*_rsa
*.key
*.pem
.env
*password*
*token*
# es_settings.cfg holds the ScreenScraper login; commit pi/snapshots/es_settings.sanitized.cfg instead
es_settings.cfg

# Personal media stays on the Pi and your backups: ROMs, discs, BIOS, archives, SD images
# (Mega Drive .md ROMs are not listed because that would also hide Markdown docs)
*.sfc
*.smc
*.nes
*.gb
*.gbc
*.gba
*.bin
*.cue
*.m3u
*.chd
*.iso
*.zip
*.7z
*.img
*.img.gz

# Local scratch
*.log
__pycache__/
.DS_Store
Thumbs.db

# Viewer: real addresses live only here
docker/.env
