<?xml version="1.0" encoding="utf-8" ?>
<!-- The whole app, a port of the browser viewer (../docker/web/app): the
     guide (picture in the corner box, programme info, grid), show details,
     settings, and the channel bar over the full-screen picture. The guide
     is drawn in the viewer's 853x480 design units, scaled by 2.25 to fill
     1920x1080; MainScene.brs builds the nodes. -->
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="MainScene.brs" />
  <children>
    <Rectangle id="black" width="1920" height="1080" color="0x000000FF" />
    <!-- The guide screen (stage), drawn by MainScene.brs. -->
    <Group id="stage" />
    <!-- The one picture: in the corner box in the guide, full screen while watching. -->
    <Video id="video" width="1920" height="1080" enableUI="false" enableTrickPlay="false" />
    <!-- "Tuning to ..." over the picture, the channel bar, short messages. -->
    <Group id="overlay" />

    <Timer id="bannerTimer" duration="4" repeat="false" />
    <Timer id="osdTimer" duration="1.5" repeat="false" />
    <Timer id="tickTimer" duration="15" repeat="true" />
    <Timer id="refreshTimer" duration="900" repeat="true" />
    <Timer id="retryTimer" duration="5" repeat="false" />
  </children>
</component>
