# Retro TV box settings. setup.sh copies this to /etc/retro-tv.env on the
# first run; edit it there and run setup.sh again. The box's start-up scripts
# read it too.

# Where ErsatzTV answers, as seen from the box: scheme, address and port, no
# trailing slash. With Tailscale on, use an address that works from anywhere.
ERSATZTV_URL=http://<server-ip>:8409

# How the CRT is connected.
#   hdmi480    HDMI at 640x480 into the HDMI-to-composite converter.
#   composite  The Pi's own 3.5 mm composite jack, 720x480i NTSC (also carries the sound).
DISPLAY_MODE=hdmi480

# What the box shows.
#   guide     the TV guide (normal)
#   overscan  the test pattern for tuning the margins below: nested frames 8 px
#             apart; the white 0 px frame should be just visible on every side
PAGE=guide

# CRT overscan margins, in pixels. A bigger number pulls the picture in from
# that edge. Start from the Trinitron's values and tune on the Sylvania.
MARGIN_LEFT=13
MARGIN_RIGHT=27
MARGIN_TOP=0
MARGIN_BOTTOM=20

# Wi-Fi comes from the settings given to Raspberry Pi Imager (network-config on
# the boot partition) and is restored from there at every boot. A second
# network name that takes the same password can be added here; the box then
# prefers it. Typical use: a dual-band router that broadcasts "Home" on 2.4 GHz
# and "Home - 5G" on 5 GHz, with the 5 GHz name given to Imager; 2.4 GHz
# reaches further, which matters behind a CRT.
WIFI_EXTRA_SSID=

# Install Tailscale (1) so the box can reach the server away from home. Signing
# in is a separate step: `sudo tailscale up` and approve on your phone.
TAILSCALE=0
